# Kibana
ES_ENDPOINT=https://kibana.sso.utils.breeze.juspay.net/_plugin/kibana/internal/search/es

# Cron (hourly email reports)
CRON_ENABLED=true
CRON_COOKIE=_pomerium=eyJ...  # Your Pomerium cookie for automated fetching

# Email — only ONE sender Gmail account needed (recipients don't need any setup)
# App password: Google Account → Security → 2-Step Verification → App Passwords
# App password is permanent — set once, works forever (unless you delete it)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
REPORT_FROM=your-sender@gmail.com

# Recipients — comma-separated, add as many as needed
REPORT_TO=anshumishra1258@gmail.com,person2@juspay.in,person3@juspay.in
